<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gridCalculadora"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:columnCount="4"
    android:rowCount="6"
    android:useDefaultMargins="true">

    <!-- Pantalla de la calculadora -->
    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_columnSpan="4"
        android:layout_gravity="fill_horizontal"
        android:background="#A9A9A9"
        android:gravity="end|center_vertical"
        android:padding="16dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="32sp" />

    <!-- Fila de Borrado (AC y C) -->
    <Button android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="2" android:layout_columnSpan="2" android:layout_gravity="fill_horizontal" android:backgroundTint="#F44336" android:text="AC" />
    <Button android:id="@+id/btnC" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="2" android:layout_columnSpan="2" android:layout_gravity="fill_horizontal" android:backgroundTint="#FF9800" android:text="C" />

    <!-- Fila 1 -->
    <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="7" />
    <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="8" />
    <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="9" />
    <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#3F51B5" android:text="/" />

    <!-- Fila 2 -->
    <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="4" />
    <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="5" />
    <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="6" />
    <Button android:id="@+id/btnMult" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#3F51B5" android:text="*" />

    <!-- Fila 3 -->
    <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="1" />
    <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="2" />
    <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="3" />
    <Button android:id="@+id/btnResta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#3F51B5" android:text="-" />

    <!-- Fila 4 -->
    <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="0" />
    <Button android:id="@+id/btnPunto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#673AB7" android:text="." />
    <Button android:id="@+id/btnIgual" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#4CAF50" android:text="=" />
    <Button android:id="@+id/btnSuma" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:backgroundTint="#3F51B5" android:text="+" />

</GridLayout>